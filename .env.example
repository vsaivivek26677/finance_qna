# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Financial Modeling Prep — free key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_free_fmp_key

# Groq — free key: https://console.groq.com   (used from Layer 3 onward)
GROQ_API_KEY=your_free_groq_key

# Database. SQLite for local dev; swap for a Postgres URL in deployment.
DATABASE_URL=sqlite:///data/financials.db

# FastAPI base URL used by the Streamlit client (Layer 5)
API_BASE_URL=http://localhost:8000

# --- Ingestion tuning (optional; sensible defaults in src/config.py) -------
# FMP_BASE_URL=https://financialmodelingprep.com
# FMP_DAILY_REQUEST_BUDGET=250
# INGEST_DEFAULT_YEARS=5
# LOG_LEVEL=INFO

# --- RAG tuning (optional) -------------------------------------------------
# Groq retires model ids regularly. List what your key can reach with:
#   python -c "from src.rag.groq_client import GroqClient; print(GroqClient().list_models())"
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# EMBEDDING_BACKEND=sentence-transformers   # or 'hashing' for offline/CI
# RAG_TOP_K=8
# RAG_BLOCK_ON_UNVERIFIED=false             # true withholds unverifiable answers

# --- Distress model tuning (optional; Layer 4) ---------------------------
# DISTRESS_MODEL_PATH=models/distress_model.joblib
# DISTRESS_DATA_DIR=data/reference/us_bankruptcy
