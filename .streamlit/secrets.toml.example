# Copy the keys you need into Streamlit Community Cloud:
#   app dashboard -> Settings -> Secrets  (paste as TOML, no [section] header)
#
# For LOCAL runs this file is not used - put the same values in a .env instead.
# The dashboard copies these into the environment at start-up so the embedded
# FastAPI backend can read them.

FMP_API_KEY = "your_free_fmp_key"
GROQ_API_KEY = "your_free_groq_key"

# Optional overrides
# GROQ_MODEL = "openai/gpt-oss-120b"
# GROQ_FALLBACK_MODEL = "openai/gpt-oss-20b"
# API_BASE_URL = "http://127.0.0.1:8000"   # leave unset to use the embedded backend
